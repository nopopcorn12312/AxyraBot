# Bot OAuth token (user access token with chat:read, chat:edit, user:bot)
# Format: oauth:xxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_BOT_OAUTH=oauth:REPLACE_WITH_BOT_ACCESS_TOKEN

TWITCH_CLIENT_ID=8ntdhbigsooa3gdey1v43hpkrf63my
TWITCH_CLIENT_SECRET=kxywyl4dzkry13zpmmw6rlqmh7h9zz

# Channel to join by default (without #)
TWITCH_CHANNEL=nopopcorn

# Optional: override where tokens.json lives (defaults next to binary)
# TWITCH_TOKENS_PATH=/app/tokens.json

# Optional: enable EventSub registration (0 = off, 1 = on)
TWITCH_EVENTSUB_ENABLED=0

# Optional: external OAuth redirect override (used by /auth/start)
# TWITCH_OAUTH_REDIRECT=https://your-domain.onrender.com/auth/callback

# Optional: Postgres connection string for multi-channel + web join flow
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
